# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/graduation

# Admin Authentication
# Generate hash using: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=$2a$10$example_hash_here_replace_with_actual_hash

# JWT Configuration
# Generate secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-at-least-32-characters-long-replace-with-random-string

# CORS Configuration
# Frontend URL for CORS (production only, development allows all origins)
FRONTEND_URL=http://localhost:3000
