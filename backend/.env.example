# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For local development: mongodb://localhost:27017/graduation
# For production (MongoDB Atlas): mongodb+srv://username:password@cluster.xxxxx.mongodb.net/graduation?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/graduation

# Admin Authentication
# Generate hash using: node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('your-password', 10).then(hash => console.log(hash));"
ADMIN_PASSWORD_HASH=$2a$10$example.hash.here

# JWT Configuration
# Use a strong random string (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters

# CORS Configuration
# Frontend URL for CORS (production only, development allows all origins)
# For Netlify: https://your-site-name.netlify.app
# For local: http://localhost:3000
FRONTEND_URL=http://localhost:3000
